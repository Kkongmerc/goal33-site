  "_template_strategy": {
    "_HOW_TO_FILL": "Copy one object out of drafts.strategies into strategies[], fill every field, then run the three generators. A product only appears on the site once it is in the published list.",
    "slug": "url-safe-id — becomes /strategies/<slug>.html and the CSS identity hook fc-<slug>. NEVER change a slug once it is live.",
    "name": "the cool display name, e.g. Spartacus",
    "actual": "the real/technical name shown as the subtitle, e.g. MNQ Two-Trend Chassis",
    "meta": "MARKET · session — first token(s) must be the uppercase market code(s) (MNQ/NQ/MGC/SI/ES); they become the market chips",
    "window": "01 Feb 2026 - 19 Aug 2026 — human-readable headline window, shown under the name",
    "best": {
      "label": "Best window — <dates>",
      "stats": {
        "EXAMPLE": "the validated figure as a display string, e.g. RoDD '21.75', PF '1.77', Win '67.0%', Net '$27.5k', Max DD '$1.3k', Trades '1,302', $/trade '$21', Months '7', RoDD/mo '3.11' Risk/trade '$732' (median losing trade at the shown Multiplier), Max loss '-$3,525' (largest single losing trade), Return on risk/mo '8075%' (avg monthly net div risk-per-trade, pre-computed -- render verbatim, do not recompute)."
      }
    },
    "full": {
      "label": "Full 2024+ window (context)",
      "stats": "same nine keys, the wider-window figures"
    },
    "price": "integer dollars/mo. Formula: eff = RoDD x min(1, sqrt(n/300)); price = round10(159 + 12*eff^1.15 - 60) - 1. Books are hand-priced ABOVE the formula.",
    "mult": "integer — the largest whole Multiplier K that keeps the best-window max drawdown under $10,000 at that size. Every published stat (Net, Max DD, $/trade) is shown AT this multiple; RoDD/PF/Win are size-independent and unaffected. Rendered wherever the headline figure sits (product-page hero, index card, plan-finder card) as 'Multiplier <mult>' -- generated from this field, never hand-written into sep/warn copy.",
    "legs": [
      "optional list of leg NAMES for multi-leg books — names only, never settings"
    ],
    "sep": [
      "one or more 'what separates this strategy' lines; the first also becomes the card blurb"
    ],
    "warn": "optional honest warning published as a trust device, e.g. a known bad week. Empty string if none.",
    "_glyph": "add a matching SVG mark in _tools/glyphs.py keyed by slug, or the glyph slot renders empty",
    "_identity": "for a flagship/book, add an fc-<slug> colour skin in main.css (see the six existing ones) to get the themed product page"
  },
